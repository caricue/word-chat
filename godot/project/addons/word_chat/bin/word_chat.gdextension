[configuration]

entry_symbol = "example_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
macos.single.debug = "./libWORD-CHAT.macos.template_debug.dylib"
macos.double.debug = "./libWORD-CHAT.macos.template_debug.double.dylib"
macos.single.release = "./libWORD-CHAT.macos.template_release.dylib"
macos.double.release = "./libWORD-CHAT.macos.template_release.double.dylib"

ios.arm64.single.debug = "./libWORD-CHAT.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "./libWORD-CHAT.ios.template_debug.arm64.double.dylib"
ios.arm64.single.release = "./libWORD-CHAT.ios.template_release.arm64.dylib"
ios.arm64.double.release = "./libWORD-CHAT.ios.template_release.arm64.double.dylib"

windows.x86_32.single.debug = "./WORD-CHAT.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "./WORD-CHAT.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.release = "./WORD-CHAT.windows.template_release.x86_32.dll"
windows.x86_32.double.release = "./WORD-CHAT.windows.template_release.x86_32.double.dll"

windows.x86_64.single.debug = "./WORD-CHAT.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./WORD-CHAT.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./WORD-CHAT.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./WORD-CHAT.windows.template_release.x86_64.double.dll"

linux.x86_64.single.debug = "./libWORD-CHAT.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./libWORD-CHAT.linux.template_debug.x86_64.double.so"
linux.x86_64.single.release = "./libWORD-CHAT.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./libWORD-CHAT.linux.template_release.x86_64.double.so"

linux.arm64.single.debug = "./libWORD-CHAT.linux.template_debug.arm64.so"
linux.arm64.double.debug = "./libWORD-CHAT.linux.template_debug.arm64.double.so"
linux.arm64.single.release = "./libWORD-CHAT.linux.template_release.arm64.so"
linux.arm64.double.release = "./libWORD-CHAT.linux.template_release.arm64.double.so"

linux.rv64.single.debug = "./libWORD-CHAT.linux.template_debug.rv64.so"
linux.rv64.double.debug = "./libWORD-CHAT.linux.template_debug.rv64.double.so"
linux.rv64.single.release = "./libWORD-CHAT.linux.template_release.rv64.so"
linux.rv64.double.release = "./libWORD-CHAT.linux.template_release.rv64.double.so"

android.x86_64.single.debug = "./libWORD-CHAT.android.template_debug.x86_64.so"
android.x86_64.double.debug = "./libWORD-CHAT.android.template_debug.x86_64.double.so"
android.x86_64.single.release = "./libWORD-CHAT.android.template_release.x86_64.so"
android.x86_64.double.release = "./libWORD-CHAT.android.template_release.x86_64.double.so"

android.arm64.single.debug = "./libWORD-CHAT.android.template_debug.arm64.so"
android.arm64.double.debug = "./libWORD-CHAT.android.template_debug.arm64.double.so"
android.arm64.single.release = "./libWORD-CHAT.android.template_release.arm64.so"
android.arm64.double.release = "./libWORD-CHAT.android.template_release.arm64.double.so"

web.wasm32.single.debug = "./libWORD-CHAT.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "./libWORD-CHAT.web.template_debug.wasm32.double.nothreads.wasm"
web.wasm32.single.release = "./libWORD-CHAT.web.template_release.wasm32.nothreads.wasm"
web.wasm32.double.release = "./libWORD-CHAT.web.template_release.wasm32.double.nothreads.wasm"